MYSQL_DATABASE=finals_compass
MYSQL_USER=finals
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
APP_ADMIN_DISPLAY_NAME=Administrator
# Generate with: openssl rand -base64 32
AI_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
AI_CALLS_PER_MINUTE=6
AI_PLATFORM_DAILY_CALLS=20
AI_PLATFORM_MONTHLY_TOKENS=100000
# Generate with: openssl rand -base64 32
MAIL_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# Generate with: openssl rand -hex 32
EMAIL_CODE_PEPPER=replace-with-random-verification-pepper
REDIS_PASSWORD=replace-with-a-long-random-password
APP_ENV=prod
APP_LOGIN_URL=https://your-domain.example
APP_FRONTEND_URL=https://your-domain.example
# Comma-separated platform origin and the exact ID shown at chrome://extensions.
BROWSER_BRIDGE_ALLOWED_ORIGINS=https://your-domain.example,chrome-extension://replace-with-extension-id
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_REDIRECT_URI=https://your-domain.example/api/system/mail/microsoft/callback
# Generate with: openssl rand -hex 32
MARKITDOWN_WORKER_TOKEN=replace-with-64-random-hex-characters
# Grafana is bound to 127.0.0.1:3000; still use a long random password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
LOG_MAX_HISTORY=30
LOG_TOTAL_SIZE_CAP=2GB
