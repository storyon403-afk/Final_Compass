{
  "name": "finals-compass-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/livedoc"
  ],
  "scripts": {
    "dev": "bash scripts/dev-frontends.sh",
    "dev:web": "npm run dev --workspace @finals-compass/web",
    "dev:livedoc": "npm run dev --workspace @finals-compass/livedoc",
    "build:web": "npm run build --workspace @finals-compass/web",
    "build:livedoc": "npm run build --workspace @finals-compass/livedoc",
    "build": "npm run build:web && npm run build:livedoc",
    "check": "npm run build"
  }
}
